@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => ctrl == c ? "active" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (signedIn)
{
    <aside class="app-sidebar" id="sidebar">
        <div class="brand"><i class="bi bi-fingerprint"></i> Attendance</div>
        <nav class="nav flex-column mt-2">
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>

            <div class="nav-heading">Setup</div>
            <a class="nav-link disabled" href="#"><i class="bi bi-diagram-3"></i> Zones</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-hdd-network"></i> Devices</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-people"></i> Employees</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-clock-history"></i> Shifts</a>

            <div class="nav-heading">Attendance</div>
            <a class="nav-link disabled" href="#"><i class="bi bi-calendar-week"></i> Roster</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-calendar-heart"></i> Holidays</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-airplane"></i> Leave</a>
            <a class="nav-link disabled" href="#"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a>
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button class="btn btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('sidebar').classList.toggle('open')">
                <i class="bi bi-list"></i>
            </button>
            <div class="fw-semibold">@ViewData["Title"]</div>
            <partial name="_LoginPartial" />
        </header>
        <main class="app-content">
            @RenderBody()
        </main>
    </div>
}
else
{
    <header class="app-topbar">
        <div class="fw-semibold"><i class="bi bi-fingerprint"></i> Attendance System</div>
        <partial name="_LoginPartial" />
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>