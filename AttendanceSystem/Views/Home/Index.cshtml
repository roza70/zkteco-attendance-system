@{
    ViewData["Title"] = "Dashboard";
}
<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#6d28d9"><i class="bi bi-people"></i></div>
            <div><div class="fs-3 fw-bold">0</div><div class="text-muted">Total Staff</div></div>
        </div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#16a34a"><i class="bi bi-check-lg"></i></div>
            <div><div class="fs-3 fw-bold">0</div><div class="text-muted">Present</div></div>
        </div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#dc2626"><i class="bi bi-person-x"></i></div>
            <div><div class="fs-3 fw-bold">0</div><div class="text-muted">Absent</div></div>
        </div></div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card"><div class="card-body d-flex align-items-center gap-3">
            <div class="stat-icon" style="background:#d97706"><i class="bi bi-airplane"></i></div>
            <div><div class="fs-3 fw-bold">0</div><div class="text-muted">Leave</div></div>
        </div></div>
    </div>
</div>